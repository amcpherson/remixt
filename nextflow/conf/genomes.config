/*
 * Reference files for each genome, relative to params.ref_data_dir.
 *
 * phasing_files are per chromosome, {chrom} is the chromosome name without a
 * chr prefix, renamed by phasing_chromosomes where the phasing panel differs.
 */

params {
    genomes = [
        GRCh38: [
            genome_fasta:   'Homo_sapiens.GRCh38.93.dna.chromosomes.fa',
            genome_fai:     'Homo_sapiens.GRCh38.93.dna.chromosomes.fa.fai',
            gap_table:      'hg38_gap.txt.gz',
            mappability:    'hg38.100.bwa.mappability.h5',
            snp_positions:  'thousand_genomes_snps.tsv',
            phasing_method: 'shapeit4',
            phasing_files:  [
                bcf_reference: '1kGP_high_coverage_Illumina.chr{chrom}.filtered.SNV_INDEL_SV_phased_panel.bcf',
                bcf_index:     '1kGP_high_coverage_Illumina.chr{chrom}.filtered.SNV_INDEL_SV_phased_panel.bcf.csi',
                genetic_map:   'chr{chrom}.b38.gmap.gz',
            ],
        ],
        GRCh37: [
            genome_fasta:   'Homo_sapiens.GRCh37.75.dna.chromosomes.fa',
            genome_fai:     'Homo_sapiens.GRCh37.75.dna.chromosomes.fa.fai',
            gap_table:      'hg19_gap.txt.gz',
            mappability:    'hg19.100.bwa.mappability.h5',
            snp_positions:  'thousand_genomes_snps.tsv',
            phasing_method: 'shapeit2',
            phasing_files:  [
                genetic_map: 'ALL_1000G_phase1integrated_v3_impute/genetic_map_chr{chrom}_combined_b37.txt',
                haplotypes:  'ALL_1000G_phase1integrated_v3_impute/ALL_1000G_phase1integrated_v3_chr{chrom}_impute.hap.gz',
                legend:      'ALL_1000G_phase1integrated_v3_impute/ALL_1000G_phase1integrated_v3_chr{chrom}_impute.legend.gz',
                sample:      'ALL_1000G_phase1integrated_v3_impute/ALL_1000G_phase1integrated_v3.sample',
            ],
            // chrX is phased against the non-PAR panel
            phasing_chromosomes: [X: 'X_nonPAR'],
        ],
    ]
}
