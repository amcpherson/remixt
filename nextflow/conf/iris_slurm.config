// Settings for running on the MSK iris slurm cluster
process.executor = 'slurm'
process.queue = 'componc_cpu'
executor.submitRateLimit = '200/2min'
executor.queueSize = 500

process.time = '24h'
process.errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
process.maxRetries = 2

singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = '-B /data1 -B /scratch'
singularity.pullTimeout = '60m'
